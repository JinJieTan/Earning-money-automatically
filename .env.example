# 模型
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL_NAME=your-230b-model
LLM_API_KEY=not-needed

# 收款
PAYPAL_EMAIL=your@email.com

# 数据库
SQLITE_PATH=./data/agent.db

# Dashboard 鉴权
DASHBOARD_JWT_SECRET=replace-with-a-long-random-secret
DASHBOARD_API_KEY=replace-with-a-long-random-api-key

# 安全白名单
ALLOWED_DOMAINS=fiverr.com,medium.com,upwork.com

# 运行参数
AGENT_TICK_CRON=*/5 * * * *
SNAPSHOT_CRON=*/30 * * * *
NODE_ENV=development
